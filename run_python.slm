#!/bin/bash
#SBATCH --account=VB-MA5HPS-005
#SBATCH --job-name=run_python
#SBATCH --output=run_python.%j.o
#SBATCH --error=run_python.%j.e
#SBATCH --nodes=6
#SBATCH --ntasks-per-node=1
#SBATCH --partition=spot-fsv2-16
#SBATCH --qos=spot-fsv2-16
#SBATCH --time=00:20:00
#SBATCH --chdir=/shared/home/em459/git_workspace/jaxmaterials

echo "====== SLURM SCRIPT ======"
cat "$0"
echo "=========================="

export OMP_NUM_THREADS=1

module purge

source /apps/build/easy_build/scripts/id_instance.sh
source /apps/build/easy_build/scripts/setup_modules.sh

module load OpenMPI/5.0.7-GCC-14.2.0
# module load CUDA/12.8.0
module load Python/3.13.1-GCCcore-14.2.0

# export LD_LIBRARY_PATH=/shared/home/em459/git_workspace/jaxmaterials/cuda/build/src/:${LD_LIBRARY_PATH}

# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#   Make sure you have run build_venv.slm to set up the environment first!
#   Without this, the next line will fail.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
source ~/venvs/jaxmaterials/bin/activate

cd examples
echo "Starting run"
mpiexec -n 6 python isotropic_distributed.py
echo "Finished run"