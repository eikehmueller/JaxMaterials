#!/bin/bash
#SBATCH --account=VB-MA5HPS-005
#SBATCH --job-name=build_venv
#SBATCH --output=build_venv.%j.o
#SBATCH --error=build_venv.%j.e
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --partition=spot-fsv2-16
#SBATCH --qos=spot-fsv2-16
#SBATCH --time=00:10:00
#SBATCH --chdir=/shared/home/em459/git_workspace/jaxmaterials

echo "====== SLURM SCRIPT ======"
cat "$0"
echo "=========================="

export OMP_NUM_THREADS=1

module purge

source /apps/build/easy_build/scripts/id_instance.sh
source /apps/build/easy_build/scripts/setup_modules.sh

module load OpenMPI/5.0.7-GCC-14.2.0
module load Python/3.13.1-GCCcore-14.2.0

python -m venv ~/venvs/jaxmaterials
source ~/venvs/jaxmaterials/bin/activate
pip install --upgrade pip pytest
pip install --no-binary=mpi4py mpi4py   # builds against the loaded OpenMPI
pip install --editable .
